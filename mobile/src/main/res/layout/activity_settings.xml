<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@color/surface_white"
            android:elevation="2dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:tint="@color/text_dark" />

            <!-- Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="PENGATURAN"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />
        </LinearLayout>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ACADEMIC METADATA CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Logo Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <!-- Music Note Icon -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="28dp"
                            app:cardBackgroundColor="@color/accent_purple">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="🎵"
                                android:textSize="28sp"
                                android:gravity="center" />
                        </androidx.cardview.widget.CardView>

                        <!-- App Name -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Adaptify Hub"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_purple" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WEARABLE BIO-RHYTHM SYNC"
                                android:textSize="10sp"
                                android:textColor="@color/text_gray"
                                android:letterSpacing="0.1"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Version Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="V1.0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/surface_white"
                            android:background="@color/accent_purple"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="16dp" />

                    <!-- Institution Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INSTITUSI"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_gray"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Politeknik Negeri Malang"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ananda Bintang R."
                            android:textSize="13sp"
                            android:textColor="@color/text_gray"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Architecture Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ARSITEKTUR"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_gray"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wear OS + Core Android SDK"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smartwatch → Phone Realtime Sync"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sistem musik adaptif berbasis data biometrik realtime dari smartwatch. Menggunakan klasifikasi aktivitas (Exercise/Stress/Relax) untuk memilih genre musik yang sesuai dengan kondisi fisiologis pengguna."
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PROJECT INFO CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INFORMASI PROYEK"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <!-- Project Type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Jenis"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tugas Akhir"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark" />
                    </LinearLayout>

                    <!-- Supervisor -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Pembimbing"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dosbim A Dosbim B"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark" />
                    </LinearLayout>

                    <!-- Build Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Build Date"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="May 2026"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TARGET USER CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface_white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET PENGGUNA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp" />

                    <!-- Usia -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Usia"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="18 – 60 tahun"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark" />
                    </LinearLayout>

                    <!-- Kondisi -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Kondisi"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sehat, tidak ada gangguan jantung"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark" />
                    </LinearLayout>

                    <!-- Aktivitas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Aktivitas"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Umum (duduk, berjalan, olahraga ringan–sedang)"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark" />
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ambang batas parameter fisiologis (detak jantung, langkah, RMSSD) dikalibrasi untuk dewasa sehat pada rentang usia tersebut berdasarkan referensi jurnal ilmiah."
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>